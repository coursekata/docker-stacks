{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Actions are Dependabot's; this covers only what Dependabot cannot see. Must run as the hosted GitHub App: a self-hosted instance on a PAT cannot produce signed commits, and required_signatures rejects unsigned ones.",
  "enabledManagers": [
    "dockerfile",
    "custom.regex"
  ],
  "pinDigests": true,
  "schedule": [
    "before 3am on monday"
  ],
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "automergeStrategy": "squash",
      "rebaseWhen": "never"
    }
  ],
  "customManagers": [
    {
      "description": "PIXI_VERSION is an ARG; the FROM tag interpolates two variables so the dockerfile manager cannot see it.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG PIXI_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "prefix-dev/pixi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
